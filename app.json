{
  "expo": {
    "name": "Doodle Bound",
    "slug": "doodle-bound",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doodlebound.app"
    },
    "android": {
      "package": "com.doodlebound.app"
    },
    "plugins": [
      [
        "react-native-widget-extension",
        {
          "name": "DoodleBoundWidget",
          "bundleIdentifier": "com.doodlebound.widget",
          "development": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "DoodleBoundWidgets",
                  "bundleIdentifier": "com.doodlebound.app.DoodleBoundWidgets",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "27ebead7-d11d-4a84-9b6e-f6ba85f5164a"
      }
    }
  }
}
